# ---- Backend configuration ----
# Copy this file to `.env` and fill in real values. `.env` is gitignored and is
# NEVER committed — set these as environment variables on your hosting platform.

# Set to "production" when hosting. This enforces the security checks below
# (strong JWT secret required, CORS locked to CLIENT_ORIGIN, no error leakage).
NODE_ENV=development

# MongoDB connection string.
#   Local install : mongodb://localhost:27017/cognizant_agents
#   MongoDB Atlas : mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/cognizant_agents
MONGODB_URI=mongodb://localhost:27017/cognizant_agents

# Port the API server listens on
PORT=5000

# Secret used to sign JWT tokens. MUST be a long random string in production.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret

# Admin login. `npm run seed` creates it if missing; `npm run set-admin` changes
# it anytime. Use a strong password (>= 8 chars) before hosting.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-password

# Email shown in the footer for queries
QUERIES_EMAIL=agent-dashboard-queries@cognizant.com

# Frontend origin allowed by CORS. In production set this to your real site
# origin (e.g. https://hub.example.com) — do NOT leave it as * when hosted.
CLIENT_ORIGIN=http://localhost:5173

# Built-in demo logins (user@cognizant.com / associate@cognizant.com) are OFF by
# default. Leave this unset/false for any hosted deployment. Set to "true" only
# for a throwaway local demo.
ENABLE_DEMO_LOGINS=false

# URL of the integrated AgentBench benchmarking app (used by the admin
# Benchmarking tab). Point this at wherever AgentBench is hosted.
BENCHMARK_URL=http://localhost:5199
