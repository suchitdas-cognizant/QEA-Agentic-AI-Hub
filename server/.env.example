# ---- Backend configuration ----
# MongoDB connection string.
#   Local install : mongodb://localhost:27017/cognizant_agents
#   MongoDB Atlas : mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/cognizant_agents
MONGODB_URI=mongodb://localhost:27017/cognizant_agents

# Port the API server listens on
PORT=5000

# Secret used to sign admin JWT tokens (change this to a long random string!)
JWT_SECRET=change-me-to-a-long-random-secret

# Default admin account created by `npm run seed`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Email shown in the footer for queries
QUERIES_EMAIL=agent-dashboard-queries@cognizant.com

# Frontend origin allowed by CORS (Vite dev server)
CLIENT_ORIGIN=http://localhost:5173
